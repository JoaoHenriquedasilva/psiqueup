# Copie este arquivo para ".env" na raiz do projeto antes de subir o backend localmente.
# Nunca versione o arquivo ".env" com segredos reais.

# Perfil Spring ativo (use "prod" em producao; deixe vazio ou "dev" localmente)
SPRING_PROFILES_ACTIVE=

# Local: jdbc:postgresql://localhost:5432/psiqueup_db
# Supabase / Cloud (Pooler ou Direto com SSL):
# DB_URL=jdbc:postgresql://<host>:<port>/postgres?sslmode=require&prepareThreshold=0
DB_URL=jdbc:postgresql://localhost:5432/psiqueup_db
DB_USERNAME=psiqueup_user
DB_PASSWORD=psiqueup_password

# Gere uma chave aleatoria com pelo menos 32 caracteres (256 bits)
JWT_SECRET=substitua-por-uma-chave-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRATION=86400000
# Pepper secreto para HMAC-SHA256 de CPF (LGPD) - obrigatorio no startup
CPF_PEPPER=substitua-por-um-pepper-secreto-aleatorio-para-hmac-cpf
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_FRONTEND_URL=http://localhost:5173
JPA_SHOW_SQL=false

# Configuracoes opcionais de SMTP para envio de e-mails transacionais em producao
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Opcional: provisiona um ADMIN inicial no startup se ambos estiverem preenchidos
ADMIN_SEED_NAME=Administrador PsiqueUp
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
